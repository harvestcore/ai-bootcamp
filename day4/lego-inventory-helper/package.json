{
  "name": "lego-inventory-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first app to track loose LEGO pieces across workshop drawer organizers, stored in a SQLite file.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "serve": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --disable-warning=ExperimentalWarning 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.182.0"
  }
}
